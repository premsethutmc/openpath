 "explanation": {
  "concept": [
   "A digit is worth different amounts in different places. In a two-digit number the first digit counts tens and the second counts ones.",
   "'The value of a digit' is how much it is worth (a tens digit is worth that many tens); 'how many tens' is just the count. The same digit answers the two questions differently."
  ],
  "visual": {
   "type": "blocks",
   "hundreds": 0,
   "tens": 1,
   "ones": 8
  },
  "visualNote": "Reuses the family's own base-ten blocks figure."
 },
 "workedExamples": [
  {
   "id": "gen:aadigit:18,0",
   "prompt": "In 18, what is the value of the digit 1?",
   "lines": [
    "18 = 1 ten and 8 ones",
    "the 1 is in the tens place: 1 ten = 10"
   ],
   "familyExplainSteps": [
    "In 18, the first digit is in the tens place.",
    "So the answer is 10."
   ],
   "answer": "10"
  },
  {
   "id": "gen:aadigit:56,1",
   "prompt": "How many tens are there in 56?",
   "lines": [
    "56 = 5 tens and 6 ones",
    "5 tens"
   ],
   "familyExplainSteps": [
    "In 56, the first digit is in the tens place.",
    "So the answer is 5."
   ],
   "answer": "5"
  }
 ],
 "hints": [
  {
   "for": "gen:aadigit:18,0",
   "hints": [
    "Which place is the digit in?",
    "Tens place: it counts tens; ones place: it counts ones.",
    "Its value is how much it is worth: tens digit × 10, ones digit as it is."
   ]
  },
  {
   "for": "gen:aadigit:56,1",
   "hints": [
    "Write the number in a Tens | Ones chart.",
    "The first digit is how many tens.",
    "The question asks for the COUNT of tens, not their value."
   ]
  }
 ],
 "alternativeExplanation": {
  "title": "Bundles of ten sticks",
  "text": [
   "Bundle sticks in tens. The first digit tells how many bundles; each bundle is worth 10."
  ],
  "visual": null
 },
