   "type": "grid",
   "rows": 1,
   "cols": 7,
   "shaded": 1
  },
  "visualNote": "Reuses the family's own grid figure."
 },
 "workedExamples": [
  {
   "id": "gen:adfname:1,7,1",
   "prompt": "What fraction of the shape in the picture is shaded? All the small squares are the same size.",
   "lines": [
    "All the equal squares: 1 × 7 = 7",
    "Shaded: 1",
    "1/7"
   ],
   "familyExplainSteps": [
    "The whole has 1 × 7 = 7 equal squares: the bottom number",
    "1 of them are shaded: 1/7"
   ],
   "answer": "1/7"
  }
 ],
 "hints": [
  {
   "for": "gen:adfname:1,7,1",
   "hints": [
    "How many equal parts make the whole shape?",
    "How many of them are shaded?",
    "Write shaded over ALL the parts."
   ]
  }
 ],
