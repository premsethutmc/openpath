+/**
+ * The essay layer's view of a competency: production's essayView (policy @4, the schedule anchored to the grade target)
+ * where the checkout has it, otherwise leafView (earlier checkouts, whose essay claim read leafView directly).
+ */
+export function essayLeaf(ectx: any, composite: any, cap: string, at: string): any {
+  return typeof (core as any).essayView === "function" ? (core as any).essayView(ectx, composite, cap, at) : core.leafView(composite, ectx.ctx.index, cap, at);
+}
