import{writeFileSync}from'node:fs';import manifest from '../../content/learning/method-alignment.v1.json';import{moduleFor}from'../../packages/learning/src/content';import{modulePhasePool}from'../../packages/learning/src/library';import{methodCompatibility,selectAligned}from'../../packages/learning/src/method-alignment';import{problemKeyOf}from'../../packages/learning/src/families';
const lessons=manifest.lessons.map(e=>{const m=moduleFor(e.competency)!,s=m.strategies.find(s=>s.id===e.strategy)!;const ids=[...new Set([s.guided,s.check,...modulePhasePool(m,'practice'),...modulePhasePool(m,'check')])];const rows=ids.map(id=>({id,...methodCompatibility(m,s,id)}));return {competency:e.competency,strategy:e.strategy,contentHash:e.contentHash,denominator:ids.length,counts:Object.fromEntries(['covered','incompatible','unknown'].map(k=>[k,rows.filter(x=>x.status===k).length])),configured:{guided:methodCompatibility(m,s,s.guided),check:methodCompatibility(m,s,s.check)},freshSelection:selectAligned(m,s,ids,new Set()).status,exhaustedSelection:selectAligned(m,s,ids,new Set(ids.map(problemKeyOf))).status,rows}});
const report={policy:manifest.policy,scope:`${manifest.lessons.length} pinned explanations, ${new Set(manifest.lessons.map(x=>x.competency)).size} competencies; other lessons unmigrated, not assumed compatible`,unit:'unique question ID × lesson; union configured guided/check and practice/check pools; formats counted separately',denominator:lessons.reduce((n,x)=>n+x.denominator,0),educatorApproved:false,lessons};writeFileSync(process.argv[2]??'/tmp/method-alignment/report.json',JSON.stringify(report,null,2));console.log(JSON.stringify({denominator:report.denominator,lessons:lessons.map(({rows,...x})=>x)},null,2));
