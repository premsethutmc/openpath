/**
 * G5: machine-readable geometry journey traces, the equivalent linear-equations journeys (same runner, same learner models, same checks),
 * and the adversarial geometric-reasoning results, plus Markdown summaries.
 *   node --import tsx scripts/g5-traces.mts <outdir>
 */
import { mkdirSync, writeFileSync } from "node:fs";
import { G5_REASONING_CASES, runReasoningCases } from "../../packages/learning/src/geometry-reasoning-g5.ts";
import { GEOMETRY_JOURNEYS, LINEAR_EQUIVALENTS, runGeometryJourney } from "../src/journey/geometry-journeys.ts";
import { checkScenario, runScenario } from "../src/journey/scenarios.ts";
import { graph } from "../../packages/learning/src/graph.ts";
import { question } from "../../packages/learning/src/content.ts";

const dir = process.argv[2];
mkdirSync(dir, { recursive: true });
const traces = GEOMETRY_JOURNEYS.map(runGeometryJourney);
writeFileSync(`${dir}/journey-traces.json`, JSON.stringify(traces, null, 1) + "\n");

const md: string[] = ["# Geometry learner journeys: traces", "", "Generated by `frontend/scripts/g5-traces.mts`. Synthetic learners: only their responses are scripted (behaviour models in `frontend/src/journey/learners.ts`); every question, grade, diagnosis, explanation and next step is the engine's. Record ids are random, every decision is deterministic.", ""];
for (const t of traces) {
  md.push(`## ${t.id} ${t.title}`, "", `Kind: **${t.kind}**. Learner model: ${t.learner}. Start (the engine's own module item): \`${t.start}\`. Ended: \`${t.ended}\`.`, "");
  md.push("| # | Activity | Question (family) | Response | Working | Trusted verdict (source, reason) | Working verdict |", "|---|---|---|---|---|---|---|");
  t.submissions.forEach((s, i) => md.push(`| ${i + 1} | ${s.activity}${s.hints ? " + hint" : ""} | \`${s.q}\` (${s.family}) | \`${s.response}\` | ${s.working.length ? "`" + s.working.join("; ") + "`" : "—"} | ${s.verdict} (${s.source}, ${s.reason}) | ${s.workingVerdict ?? "—"} |`));
  md.push("", "Engine decisions, in order:", "");
  for (const st of t.steps.filter((x) => x.component !== "server-grader.gradeRequest")) md.push(`- ${st.n}. \`${st.component}\` (${st.decides}): ${st.summary}`);
  md.push("", `Teaching delivered: ${t.teaching.length ? t.teaching.map((x) => `${x.strategy} (checked ${x.eligibility.checked}, eligible ${x.eligibility.eligible}, ${x.eligibility.review})`).join("; ") : "none"}.`, "");
  for (const [c, a] of Object.entries(t.authoritative)) md.push(`Authoritative (unchanged engine) — \`${c}\`: ${a.status}, verified ${a.verified}, alone ${a.independent}, helped ${a.assisted}, delayed check ${a.retention} (${a.retentionHistory.join(", ") || "none"}), shared engine ${a.engine}.`);
  md.push("");
  for (const [c, p] of Object.entries(t.projections)) {
    md.push(`Sub-skill projection (shadow) — \`${c}\`: outcome ${p.outcome}; unknown ${JSON.stringify(p.unknown)}; discrepancies ${p.discrepancies.length ? p.discrepancies.map((d) => `${d.claim}: ${d.unsupported.map((u) => `${u.id} ${u.status}`).join(", ")}`).join("; ") : "none"}.`, "");
    md.push("| Sub-skill | Status | Alone right / total | Helped right | Method | Rechecks | Delayed check (history) |", "|---|---|---|---|---|---|---|");
    for (const [k, v] of Object.entries(p.subSkills)) md.push(`| ${k} | ${v.status} | ${v.independentRight} / ${v.independent} | ${v.assistedRight} | ${v.method} | ${v.rechecks.join(", ") || "—"} | ${v.retention} (${v.retentionHistory.join(", ") || "—"}) |`);
    md.push("");
  }
  md.push(`Replay after restart (records only): state identical ${t.replay.identicalState}, projection identical ${t.replay.identicalProjection}, next module decision identical ${t.replay.identicalNextModuleDecision}, reversed store order identical ${t.replay.reversedOrderProjectionIdentical}.`, "");
  md.push(`Shared scenario properties: ${t.properties.map((p) => `${p.ok ? "✓" : "✗"} ${p.property}`).join(" · ")}`, "");
}
writeFileSync(`${dir}/journey-traces.md`, md.join("\n") + "\n");

// the equivalent linear-equations journeys, the same runner and checks
const lin = LINEAR_EQUIVALENTS.map((s) => {
  const r = runScenario(s); const st = r.f.session.state(); const target = graph.evidenceTarget(question(s.start).competency); const e = st.evidence(target);
  const teaches = (r.f.session.events as unknown as { record?: string; strategy: string }[]).filter((x) => x.record === "teach").map((x) => x.strategy);
  return { id: s.id, start: s.start, ended: r.f.ended?.phase ?? null, submissions: r.f.session.replies.length, teaching: teaches, authoritative: { status: e.status, independent: `${e.independent.right}/${e.independent.total}`, assisted: `${e.assisted.right}/${e.assisted.total}`, retentionHistory: (e.retentionHistory ?? []).map((h) => h.result + (h.recoveredAt ? "+recovered" : "")) }, properties: checkScenario(r), components: [...new Set(r.f.session.trace.map((t) => t.component))].sort() };
});
const geoComponents = (id: string) => { const t = traces.find((x) => x.id === id)!; return [...new Set(t.steps.map((s) => s.component))].sort(); };
writeFileSync(`${dir}/cross-domain-journeys.json`, JSON.stringify({ linear: lin, geometryComponents: Object.fromEntries(traces.map((t) => [t.id, geoComponents(t.id)])) }, null, 1) + "\n");

const reasoning = await runReasoningCases();
writeFileSync(`${dir}/reasoning-results.json`, JSON.stringify({ authority: "unified-math-engine assessMathematicalWorking → research/geometry-reasoner (openpath-geometry-worker@2)", cases: reasoning.map((r) => ({ ...r, why: G5_REASONING_CASES.find((c) => c.id === r.id)!.why })) }, null, 1) + "\n");
console.log(traces.map((t) => `${t.id} ${t.ended} props ${t.properties.filter((p) => p.ok).length}/10`).join("\n"));
console.log(lin.map((l) => `${l.id} ${l.ended} props ${l.properties.filter((p) => p.ok).length}/10`).join("\n"));
console.log(reasoning.map((r) => `${r.id} ${r.verdict} ${r.outcome}`).join("\n"));
process.exit(0);
