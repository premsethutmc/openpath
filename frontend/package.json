{
  "name": "openpath-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build.mjs --standalone",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.english.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "e2e": "node --test e2e/play.test.mjs",
    "english:build": "node scripts/build-english.mjs",
    "english:preview": "node scripts/preview-english.mjs",
    "english:e2e": "node --test e2e/english.test.mjs",
    "english:demo-journeys": "node scripts/demo-journeys.mjs",
    "english:demo-profiles": "node --import tsx scripts/demo-profiles.mts",
    "english:e2e-accounts": "node --test e2e/accounts.test.mjs",
    "english:e2e-developer": "node --test e2e/developer.test.mjs",
    "english:e2e-spelling": "node --test e2e/spelling.test.mjs",
    "english:e2e-pilot": "node --test e2e/pilot.test.mjs",
    "english:e2e-pilot-bee": "node --test e2e/pilot-bee.test.mjs",
    "english:e2e-demo": "node --test e2e/demo.test.mjs",
    "english:e2e-bee": "node --test e2e/bee.test.mjs",
    "english:e2e-mywords": "node --test e2e/mywords.test.mjs",
    "english:e2e-parent-content": "node --test e2e/parent-content.test.mjs",
    "english:demo-server": "node scripts/demo-server.mjs",
    "english:demo-hash-password": "node scripts/demo-hash-password.mjs",
    "english:demo-dictation": "node --import tsx scripts/demo-dictation.mts",
    "english:build:pilot": "node scripts/build-english.mjs --pilot",
    "english:build:preview": "node scripts/build-english.mjs --preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
