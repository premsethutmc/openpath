[
 {
  "id": "h7-algA-001",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "concise"
  ],
  "p": {
   "alg": "2x+3=11"
  },
  "w": "2x=8\nx=4",
  "exp": "verified",
  "why": "Subtract 3 then halve is valid."
 },
 {
  "id": "h7-algA-002",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "3(x-2)=2x+5"
  },
  "w": "3x-6=2x+5\nx=11",
  "exp": "verified",
  "why": "Expand and collect: x=11."
 },
 {
  "id": "h7-algA-003",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x^2-5x+6=0"
  },
  "w": "(x-2)(x-3)=0\nx=2 or x=3",
  "exp": "verified",
  "why": "Correct factorisation and zero-product rule."
 },
 {
  "id": "h7-algA-004",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "x^2+6x+4=0"
  },
  "w": "(x+3)^2=5\nx+3=±sqrt(5)\nx=-3±sqrt(5)",
  "exp": "verified",
  "why": "Completing the square: x^2+6x+9=5 is equivalent; both signs kept."
 },
 {
  "id": "h7-algA-005",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "2x^2-3x-5=0"
  },
  "w": "disc = 9+40 = 49\nx = (3±7)/4\nx = 5/2 or x = -1",
  "exp": "verified",
  "why": "Quadratic formula with discriminant 49 gives 5/2 and -1."
 },
 {
  "id": "h7-algA-006",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "concise"
  ],
  "p": {
   "alg": "x^2=49"
  },
  "w": "x=±7",
  "exp": "verified",
  "why": "Both square roots of 49."
 },
 {
  "id": "h7-algA-007",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(x^2-9)/(x-3)=6"
  },
  "w": "x≠3\n(x^2-9)/(x-3)=x+3\nx+3=6\nx=3, which is excluded, so there is no solution",
  "exp": "verified",
  "why": "Cancellation justified by x≠3; the only candidate is excluded."
 },
 {
  "id": "h7-algA-008",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "sqrt(x+2)=x"
  },
  "w": "x+2=x^2\n(x-2)(x+1)=0\nx=2 or x=-1\ncheck x=-1: sqrt(1)=1≠-1, rejected\nx=2: sqrt(4)=2 ok\nso x=2",
  "exp": "verified",
  "why": "Squaring then checking removes extraneous x=-1."
 },
 {
  "id": "h7-algA-009",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "|2x-1|=5"
  },
  "w": "2x-1=5 or 2x-1=-5\nx=3 or x=-2",
  "exp": "verified",
  "why": "Both branches of absolute value."
 },
 {
  "id": "h7-algA-010",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "-2x+3>7"
  },
  "w": "-2x>4\nx<-2",
  "exp": "verified",
  "why": "Dividing by -2 reverses the inequality."
 },
 {
  "id": "h7-algA-011",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x^2-4x-5<0"
  },
  "w": "(x-5)(x+1)<0\n-1<x<5",
  "exp": "verified",
  "why": "Product negative between the roots."
 },
 {
  "id": "h7-algA-012",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "concise"
  ],
  "p": {
   "alg": "|x-3|<2"
  },
  "w": "-2<x-3<2\n1<x<5",
  "exp": "verified",
  "why": "Standard absolute-value inequality."
 },
 {
  "id": "h7-algA-013",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "1/x+1/(x+1)=1"
  },
  "w": "x≠0 and x≠-1\nmultiply by x(x+1): 2x+1=x^2+x\nx^2-x-1=0\nx=(1±sqrt(5))/2\nboth values differ from 0 and -1",
  "exp": "verified",
  "why": "Restrictions stated, quadratic correct, roots admissible."
 },
 {
  "id": "h7-algA-014",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "x^2-4x-12=0"
  },
  "w": "x^2-4x=12\n(x-2)^2=16\nx-2=±4\nx=6 or x=-2",
  "exp": "verified",
  "why": "Completing the square with both signs."
 },
 {
  "id": "h7-algA-015",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "concise"
  ],
  "p": {
   "alg": "5x-7=3x+9"
  },
  "w": "x=8",
  "exp": "verified",
  "why": "2x=16 so x=8."
 },
 {
  "id": "h7-algA-016",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "x^4-5x^2+4=0"
  },
  "w": "let u=x^2: u^2-5u+4=0\n(u-1)(u-4)=0\nu=1 or u=4\nx=±1 or x=±2",
  "exp": "verified",
  "why": "Quadratic in x^2; all four real roots."
 },
 {
  "id": "h7-algA-017",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "concise"
  ],
  "p": {
   "alg": "(x-1)(x-4)=0"
  },
  "w": "x=1 or x=4",
  "exp": "verified",
  "why": "Zero-product rule."
 },
 {
  "id": "h7-algA-018",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "x^3-x^2-4x+4=0"
  },
  "w": "x^2(x-1)-4(x-1)=0\n(x-1)(x-2)(x+2)=0\nx=1, 2 or -2",
  "exp": "verified",
  "why": "Factor by grouping; roots 1,2,-2."
 },
 {
  "id": "h7-algA-019",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "sqrt(2x+3)=3"
  },
  "w": "2x+3=9\nx=3\ncheck: sqrt(9)=3",
  "exp": "verified",
  "why": "Square and verify."
 },
 {
  "id": "h7-algA-020",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "concise"
  ],
  "p": {
   "alg": "3x-5<=10"
  },
  "w": "3x<=15\nx<=5",
  "exp": "verified",
  "why": "Positive divisor keeps direction."
 },
 {
  "id": "h7-algA-021",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x/3+x/6=2"
  },
  "w": "multiply by 6: 2x+x=12\n3x=12\nx=4",
  "exp": "verified",
  "why": "Clearing denominators."
 },
 {
  "id": "h7-algA-022",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "|x+1|=|2x-3|"
  },
  "w": "square both sides: (x+1)^2=(2x-3)^2\n3x^2-14x+8=0\n(3x-2)(x-4)=0\nx=2/3 or x=4",
  "exp": "verified",
  "why": "For |a|=|b| squaring is an equivalence; roots correct."
 },
 {
  "id": "h7-algA-023",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(x+2)/(x-1)=3"
  },
  "w": "x≠1\nx+2=3x-3\n5=2x\nx=5/2",
  "exp": "verified",
  "why": "Valid multiplication with x≠1; 5/2≠1."
 },
 {
  "id": "h7-algA-024",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "x^2-2x-1=0"
  },
  "w": "x=(2±sqrt(4+4))/2=(2±2sqrt(2))/2=1±sqrt(2)",
  "exp": "verified",
  "why": "Quadratic formula simplified."
 },
 {
  "id": "h7-algA-025",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x^2-x-6>=0"
  },
  "w": "(x-3)(x+2)>=0\nx<=-2 or x>=3",
  "exp": "verified",
  "why": "Upward parabola nonnegative outside roots."
 },
 {
  "id": "h7-algA-026",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(x-1)/(x+2)>0"
  },
  "w": "for x≠-2 the sign of (x-1)/(x+2) equals the sign of (x-1)(x+2)\n(x-1)(x+2)>0\nx<-2 or x>1",
  "exp": "verified",
  "why": "Quotient and product have equal sign; solution set correct."
 },
 {
  "id": "h7-algA-027",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "3(2x-1)-2(x+4)=5x"
  },
  "w": "6x-3-2x-8=5x\n4x-11=5x\nx=-11",
  "exp": "verified",
  "why": "Expand and collect."
 },
 {
  "id": "h7-algA-028",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x/2-1/3=5/6"
  },
  "w": "3x-2=5\nx=7/3",
  "exp": "verified",
  "why": "Multiply by 6."
 },
 {
  "id": "h7-algA-029",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(2x-1)/3<=x+1"
  },
  "w": "2x-1<=3x+3\n-4<=x\nx>=-4",
  "exp": "verified",
  "why": "Multiply by positive 3; reading right."
 },
 {
  "id": "h7-algA-030",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "5-2x<=9"
  },
  "w": "-2x<=4\nx>=-2",
  "exp": "verified",
  "why": "Divide by -2 reverses."
 },
 {
  "id": "h7-algA-031",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "sqrt(x+1)+1=x"
  },
  "w": "sqrt(x+1)=x-1\nx+1=x^2-2x+1\nx(x-3)=0\nx=0: 1+1=2≠0 rejected\nx=3: 2+1=3 ok\nx=3",
  "exp": "verified",
  "why": "Isolate, square, check."
 },
 {
  "id": "h7-algA-032",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(x^2+1)(x-3)=2(x^2+1)"
  },
  "w": "x^2+1>0 for all real x, so divide by it\nx-3=2\nx=5",
  "exp": "verified",
  "why": "Divisor shown nonzero."
 },
 {
  "id": "h7-algA-033",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "method"
  ],
  "p": {
   "alg": "x^2-3x-4>0"
  },
  "w": "x^2-3x-4=(x-4)(x+1)\nparabola opens upward so it is positive outside the roots\nx<-1 or x>4",
  "exp": "verified",
  "why": "Correct sign analysis."
 },
 {
  "id": "h7-algA-034",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "|2x+1|>=3"
  },
  "w": "2x+1>=3 or 2x+1<=-3\nx>=1 or x<=-2",
  "exp": "verified",
  "why": "Correct two-ray split."
 },
 {
  "id": "h7-algA-035",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "conditional"
  ],
  "p": {
   "alg": "|x+1|=2x"
  },
  "w": "case x+1>=0: x+1=2x gives x=1, valid since 1>=-1\ncase x+1<0: -(x+1)=2x gives x=-1/3, but -1/3 is not < -1, rejected\nx=1",
  "exp": "verified",
  "why": "Case split with admissibility checks."
 },
 {
  "id": "h7-algA-036",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "1/x+1/3=1/2"
  },
  "w": "1/x=1/2-1/3=1/6\nx=6",
  "exp": "verified",
  "why": "Reciprocal of 1/6."
 },
 {
  "id": "h7-algA-037",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "side-claim"
  ],
  "p": {
   "alg": "x^2-9=0"
  },
  "w": "(x-3)(x+3)=0\nx=3 or x=-3\nNote that 3^2=9 and 7 is prime.",
  "exp": "verified",
  "why": "Solution complete; the extra remark is true and harmless."
 },
 {
  "id": "h7-algA-038",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "side-claim"
  ],
  "p": {
   "alg": "4x=20"
  },
  "w": "x=5\nAlso 2+2=4.",
  "exp": "verified",
  "why": "Correct solution plus a true irrelevant line."
 },
 {
  "id": "h7-algA-039",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "side-claim"
  ],
  "p": {
   "alg": "2x-6=0"
  },
  "w": "2x=6\nx=3\nIncidentally 3 is odd.",
  "exp": "verified",
  "why": "Correct solution; side line true."
 },
 {
  "id": "h7-algA-040",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "3x+2=5x-6"
  },
  "w": "3x-5x=-6-2\n-2x=-8\nx=-4",
  "exp": "invalid",
  "why": "-8/-2 = 4, not -4: sign error."
 },
 {
  "id": "h7-algA-041",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "cancellation"
  ],
  "p": {
   "alg": "x^2-4x=x"
  },
  "w": "x-4=1\nx=5",
  "exp": "invalid",
  "alt": [
   "missing-assumption"
  ],
  "why": "Dividing by x loses root x=0; claimed solution set {5} is wrong."
 },
 {
  "id": "h7-algA-042",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "extraneous"
  ],
  "p": {
   "alg": "sqrt(x+6)=x"
  },
  "w": "x+6=x^2\n(x-3)(x+2)=0\nx=3 or x=-2",
  "exp": "invalid",
  "why": "x=-2 is extraneous: sqrt(4)=2≠-2."
 },
 {
  "id": "h7-algA-043",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "dropped-pm"
  ],
  "p": {
   "alg": "(x-3)^2=16"
  },
  "w": "x-3=4\nx=7",
  "exp": "invalid",
  "why": "Dropped x-3=-4, so x=-1 is lost."
 },
 {
  "id": "h7-algA-044",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "inequality-sign"
  ],
  "p": {
   "alg": "-3x<12"
  },
  "w": "x<-4",
  "exp": "invalid",
  "why": "Dividing by -3 must reverse: x>-4."
 },
 {
  "id": "h7-algA-045",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "solution-set"
  ],
  "p": {
   "alg": "x^2>9"
  },
  "w": "x>3",
  "exp": "invalid",
  "why": "Solution set is x<-3 or x>3."
 },
 {
  "id": "h7-algA-046",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "solution-set"
  ],
  "p": {
   "alg": "x^2-x-6<0"
  },
  "w": "(x-3)(x+2)<0\nx<3 or x>-2",
  "exp": "invalid",
  "why": "Should be -2<x<3 (and, not or); 'or' gives all reals."
 },
 {
  "id": "h7-algA-047",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(x+1)^2=4"
  },
  "w": "x^2+1=4\nx^2=3\nx=±sqrt(3)",
  "exp": "invalid",
  "why": "(x+1)^2≠x^2+1; forged expansion."
 },
 {
  "id": "h7-algA-048",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "correct-final"
  ],
  "p": {
   "alg": "4x-8=0"
  },
  "w": "4x=8\nx=8-6\nx=2",
  "exp": "invalid",
  "why": "x=8-6 is false as a step (4x=8 gives x=8/4) though result 2 is right."
 },
 {
  "id": "h7-algA-049",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "|x-2|=-3"
  },
  "w": "x-2=3 or x-2=-3\nx=5 or x=-1",
  "exp": "invalid",
  "why": "An absolute value cannot be -3; neither value satisfies it."
 },
 {
  "id": "h7-algA-050",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "extraneous"
  ],
  "p": {
   "alg": "sqrt(x+1)+1=x"
  },
  "w": "sqrt(x+1)=x-1\nx+1=x^2-2x+1\nx(x-3)=0\nx=0 or x=3",
  "exp": "invalid",
  "why": "x=0 is extraneous: 1+1≠0."
 },
 {
  "id": "h7-algA-051",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "sqrt(x^2+16)=5"
  },
  "w": "x+4=5\nx=1",
  "exp": "invalid",
  "why": "sqrt(x^2+16)≠x+4; true solutions are x=±3."
 },
 {
  "id": "h7-algA-052",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "1/x+1/3=1/2"
  },
  "w": "x+3=2\nx=-1",
  "exp": "invalid",
  "why": "1/x+1/3 is not 1/(x+3); x=-1 gives -2/3≠1/2."
 },
 {
  "id": "h7-algA-053",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "(x+1)/2=(x-1)/3"
  },
  "w": "3x+1=2x-1\nx=-2",
  "exp": "invalid",
  "why": "Cross-multiplying gives 3x+3=2x-2; line is false."
 },
 {
  "id": "h7-algA-054",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x^2+4x-5=0"
  },
  "w": "x=(-4±sqrt(16-20))/2",
  "exp": "invalid",
  "why": "Discriminant is 16+20=36, sign error."
 },
 {
  "id": "h7-algA-055",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "x^2+6x=7"
  },
  "w": "(x+3)^2=7\nx=-3±sqrt(7)",
  "exp": "invalid",
  "why": "Completing the square requires adding 9: (x+3)^2=16."
 },
 {
  "id": "h7-algA-056",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
   "alg": "|2x-3|>5"
  },
  "w": "2x-3>5 and 2x-3<-5\nx>4 and x<-1",
  "exp": "invalid",
  "why": "Should be 'or'; 'and' yields an empty set, wrong claim."
 },
 {
  "id": "h7-algA-057",
  "cat": "algebra-equations",
  "tags": [
   "algA",
   "divide-by-zero"
  ],
  "p": {
   "alg": "x-2=0"
  },
  "w": "x=2\nx^2=2x\nx^2-4=2x-4\n(x+2)(x-2)=2(x-2)\nx+2=2\nx=0",
  "exp": "invalid",
  "why": "Divides by x-2=0, producing false x=0."
 },
 {
  "id": "h7-algA-058",
  "cat": "algebra-equations",
  "tags": [
   "algA"
  ],
  "p": {
