"p": {
"alg": "x^2 = 4x"
},
"w": {
"raw": [
"Case x = 0: 0 = 0 holds, so x = 0 is a solution.",
"Case x ≠ 0: divide by x to get x = 4.",
"Hence x = 0 or x = 4."
]
},
"exp": "verified",
"why": "Splitting on x=0 and x≠0 gives solutions 0 and 4."
},
{
"id": "h7-typed-092",
"cat": "typed-routes",
"tags": [
"text-lines",
"conditional"
],
"p": {
"alg": "|x-1| = 2"
},
"w": {
"raw": [
"If x - 1 ≥ 0 then x - 1 = 2, so x = 3.",
"If x - 1 < 0 then 1 - x = 2, so x = -1.",
"Therefore x = 3 or x = -1."
]
},
"exp": "verified",
"why": "Both branches are consistent with their conditions; solutions 3 and -1."
},
