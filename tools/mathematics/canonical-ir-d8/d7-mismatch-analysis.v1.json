    {
      "id": "d7-derivative-050",
      "notation": "∂p/∂x = 2x^1",
      "expectedInterpretation": "first partial derivative of the named dependent with respect to the named variable",
      "actualTypedRepresentation": {
        "kind": "derivative",
        "notation": "∂p/∂x = 2x^1",
        "dependent": "p",
        "variable": "x",
        "order": 1,
        "partial": true,
        "result": {
          "kind": "multiply",
          "factors": [
            {
              "kind": "constant",
              "value": "2"
            },
            {
              "kind": "power",
              "base": {
                "kind": "variable",
                "name": "x"
              },
              "exponent": 1
            }
          ]
        }
      },
      "expectedTypedRepresentation": {
        "kind": "derivative",
        "functionName": "p",
        "dependent": "p",
        "variable": "x",
        "order": 1,
        "partial": true
      },
      "exactDifference": "expected duplicates dependent into functionName; actual stores the dependent identity once",
      "classification": "harmless representation/reference-shape difference",
      "mathematicalMeaningChanges": false,
      "d3BindingBehaviorChanges": false,
      "u4VerificationChanges": false,
      "reason": "dependent is the function-valued symbol for partial notation; duplication is not semantic"
    },
